<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="payment_term_form_inherited_updated" model="ir.ui.view">
            <field name="name">payment.term.form.inherited.updated</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="purchase_id" invisible="purchase_id == False"/>
                    <field name="payment_reference" readonly="True" invisible="True"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
