<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View for Company Mapping -->
    <record id="view_company_mapping_form" model="ir.ui.view">
        <field name="name">company.mapping.form</field>
        <field name="model">company.mapping</field>
        <field name="arch" type="xml">
            <form string="Company Mapping">
                <sheet>
                    <group>
                        <field name="ad_set_name"/>
                        <field name="company_id" options="{'no_edit': True, 'no_create': True}"/>
                        <field name="salesperson_id" widget="many2one_avatar_user" options="{'no_edit': True, 'no_create': True}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View for Company Mapping -->
    <record id="view_company_mapping_tree" model="ir.ui.view">
        <field name="name">company.mapping.tree</field>
        <field name="model">company.mapping</field>
        <field name="arch" type="xml">
            <list string="Company Mappings">
                <field name="ad_set_name"/>
                <field name="company_id"/>
                <field name="salesperson_id"/>
            </list>
        </field>
    </record>

    <!-- Action for Company Mapping -->
    <record id="action_company_mapping" model="ir.actions.act_window">
        <field name="name">Company Ad Set Mappings</field>
        <field name="res_model">company.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item for Company Mapping -->
    <menuitem id="menu_company_mapping" name="Company Ad Set Mappings" parent="crm.crm_menu_config" action="action_company_mapping"/>
</odoo>
